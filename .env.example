# ============================================================================
# AegisQA backend (Python). Copy to .env and fill in. On GCP these come from
# Cloud Run / GKE env vars and Secret Manager -- see docs/GCP_HANDOFF.md.
# ============================================================================

# --- Database: PostgreSQL (Cloud SQL on GCP) ---------------------------------
# Local Homebrew Postgres: postgresql://<your-mac-username>@localhost:5432/aegisqa
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aegisqa

# --- Model: Gemini via Vertex AI ---------------------------------------------
# Locally: run `gcloud auth application-default login` once. On GCP the
# service account is used automatically (no keys).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
# Alternative for local testing without a GCP project (Google AI Studio key):
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-ai-studio-key

# Model calls allowed per chat turn.
MAX_LLM_CALLS_PER_TURN=20

# --- Login --------------------------------------------------------------------
# The first admin account, created by `python -m aegisqa.seed` (only when no
# users exist yet; stored as a password hash).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Encrypts environment credentials and integration tokens at rest (AES-256-GCM).
# Generate once and never change it afterwards:
#   python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_ENCRYPTION_KEY=generate_and_paste_64_character_hex_key_here

# --- HTTP ---------------------------------------------------------------------
PORT=4000
# Where the frontend is served from (CORS + cookies). Comma-separate several.
FRONTEND_ORIGIN=http://localhost:3000

# --- Browsers (Playwright MCP) --------------------------------------------------
# Empty: spawn `npx @playwright/mcp` per session (needs `npm install` in this
# repo). Set: connect to a Playwright MCP server over Streamable HTTP,
# e.g. http://localhost:8931/mcp.
PLAYWRIGHT_MCP_URL=
PLAYWRIGHT_BROWSER=chromium
# false = watch the browser while the agent works (local debugging).
PLAYWRIGHT_HEADLESS=true
BROWSER_IDLE_TIMEOUT_SECONDS=600

# --- Memory layer ------------------------------------------------------------------
# Semantic search: pgvector (default; needs the `vector` extension -- Cloud SQL has
# it, locally `brew install pgvector`), vertex_vector_search, or none.
MEMORY_SEMANTIC_BACKEND=pgvector
# Keyword search: postgres (default, full-text) or firestore (BM25).
MEMORY_KEYWORD_BACKEND=postgres
# Embeddings (768-dimensional) for semantic search.
EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_LOCATION=us-central1   # only if the embedding model isn't in GOOGLE_CLOUD_LOCATION
# Only with MEMORY_SEMANTIC_BACKEND=vertex_vector_search (full resource names):
# VECTOR_SEARCH_INDEX=projects/PROJECT/locations/REGION/indexes/INDEX_ID
# VECTOR_SEARCH_INDEX_ENDPOINT=projects/PROJECT/locations/REGION/indexEndpoints/ENDPOINT_ID
# VECTOR_SEARCH_DEPLOYED_INDEX_ID=aegisqa_memory
# VECTOR_SEARCH_ENDPOINT_DOMAIN=1234567890.REGION-PROJECT_NUMBER.vdb.vertexai.goog
# Only with MEMORY_KEYWORD_BACKEND=firestore:
# FIRESTORE_DATABASE=(default)
# FIRESTORE_COLLECTION_PREFIX=aegisqa

# --- Files (screenshots, traces/videos, visual baselines) -----------------------
# local (the directories below) or gcs (ARTIFACTS_BUCKET).
ARTIFACT_STORAGE=local
# ARTIFACTS_BUCKET=your-artifacts-bucket
SCREENSHOTS_DIR=./data/screenshots
ARTIFACTS_DIR=./data/mcp-artifacts
VISUAL_REGRESSION_DIR=./data/visual-regression
VISUAL_DIFF_THRESHOLD_PERCENT=0.1

# --- Background work ----------------------------------------------------------------
# inline (default): test runs run inside the backend.
# pubsub: they go through Pub/Sub and execute on `python -m aegisqa.worker`.
TASK_QUEUE=inline
# Only with TASK_QUEUE=pubsub:
# PUBSUB_RUNS_TOPIC=projects/PROJECT/topics/aegisqa-runs
# PUBSUB_RUNS_SUBSCRIPTION=projects/PROJECT/subscriptions/aegisqa-runs-worker   (worker)
# INTERNAL_AUDIENCE=https://your-backend-url        (audience of the OIDC tokens on /internal/*)
# INTERNAL_INVOKERS=worker@PROJECT.iam.gserviceaccount.com
# BACKEND_INTERNAL_URL=https://your-backend-url     (worker -> backend, live run progress)

# --- Misc -------------------------------------------------------------------------
# Max test cases run at once by "Run all" / data-driven runs.
MAX_PARALLEL_RUNS=3
# Optional: POSTed (Slack-compatible "text" field) when a run doesn't pass.
WEBHOOK_URL=
